# Set only in Vercel Environment Variables or a local untracked .env.local.
# Use the Neon connection string for the intended branch/environment.
DATABASE_URL=
# Neon Managed Auth URL for the same database branch.
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32. Keep secret; never commit its value.
NEON_AUTH_COOKIE_SECRET=
# Public canonical origin for metadata (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.mbcindonesia.id
