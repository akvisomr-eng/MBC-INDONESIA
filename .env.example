# Required for live database-backed endpoints
DATABASE_URL=

# Neon Managed Auth — set the URL for the SAME Neon branch as DATABASE_URL
NEON_AUTH_BASE_URL=
# Generate a random secret of at least 32 characters and store only in deployment secrets
NEON_AUTH_COOKIE_SECRET=
# Comma-separated allowlist of emails permitted to access admin functions (fail-closed)
MBC_ADMIN_EMAILS=

# Canonical public origin for metadata and sitemap
NEXT_PUBLIC_SITE_URL=https://www.mbcindonesia.id

# Future integrations; never commit real values
AI_PROVIDER=
AI_API_KEY=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=